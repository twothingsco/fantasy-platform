# ============================================================================
#  fantasy-platform — environment template
#  Copy the blocks you need into the per-app .env files listed below.
#  Nothing in this file is a real credential.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase  (apps/sim-edge/.env, apps/genius-feed/.env.local)
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only — never ship to a browser

# ---------------------------------------------------------------------------
# Genius Sports — Statistics API v2  (apps/genius-feed)
# Fixtures, teams, players, post-game stats.  Used by src/auth.ts
# ---------------------------------------------------------------------------
GENIUS_STATS_CLIENT_ID=
GENIUS_STATS_CLIENT_SECRET=
GENIUS_STATS_API_KEY=

# ---------------------------------------------------------------------------
# Genius Sports — MatchState API  (apps/genius-feed)
# Live-feed handshake that hands back the per-fixture Ably channel + token.
# Separate product, separate credentials.  Used by src/auth-matchState.ts
# ---------------------------------------------------------------------------
GENIUS_MATCHSTATE_CLIENT_ID=
GENIUS_MATCHSTATE_CLIENT_SECRET=
GENIUS_MATCHSTATE_API_KEY=

# ---------------------------------------------------------------------------
# Yahoo Fantasy OAuth  (apps/sim-edge — supabase secrets)
# ---------------------------------------------------------------------------
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=

# ---------------------------------------------------------------------------
# LLM  (apps/sim-edge — _shared/llmService.ts)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Dashboard  (apps/dashboard/.env.development) — VITE_ vars reach the browser,
# so only ever the anon key here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_EXPRESS_PORT=
