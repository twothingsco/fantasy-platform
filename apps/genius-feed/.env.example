# apps/genius-feed/.env.local  — point at whichever Supabase you're filling.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Genius Sports — Statistics API v2 (fixtures / teams / players / stats)
GENIUS_STATS_CLIENT_ID=
GENIUS_STATS_CLIENT_SECRET=
GENIUS_STATS_API_KEY=

# Genius Sports — MatchState API (live feed -> Ably channel)
GENIUS_MATCHSTATE_CLIENT_ID=
GENIUS_MATCHSTATE_CLIENT_SECRET=
GENIUS_MATCHSTATE_API_KEY=
